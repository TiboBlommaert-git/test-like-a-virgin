<!DOCTYPE html>
<html lang="{{ craft.app.language }}">
	<head>
		<meta charset="utf-8"/>
		<title>{{ siteName }}</title>
		<meta content="width=device-width, initial-scale=1.0" name="viewport">
		<link href="{{ alias('@web') }}/assets/css/main.css" rel="stylesheet">
		<script src="https://unpkg.com/i18next/i18next.js"></script>
		<script src="http://test.ddev.site/assets/js/main.js"></script>
		{# <script src="http://test.ddev.site/assets/js/language.js"></script> #}
		<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
	</head>
	<body>
		{% set navSegment = craft.app.request.getSegment(1) %}
		<div class="c-navoverzicht_fixed-wrapper">
			<div class="container">
				<div class="row">
					<nav class="c-navoverzicht d-flex align-items-center">
						<div class="c-nav_container">
							<div>
								<a href="{{ siteUrl }}"><img src="/uploads/images/Logonetflix.png" class="c-navoverzicht_logo"></a>
							</div>
							<div class="c-nav_settings d-flex align-items-center">
								<div class="c-nav_settings-language-container">
									<form id="languageContent">
									<select name="language" class="c-nav_settings-layout" onchange="changeLanguage(this)" id="languageSwitcher">
										{% for site in craft.app.sites.allSites %}
											<option value="{{ site.baseUrl('/entertainment') }}" {{ site.handle == craft.app.sites.currentSite.handle ? 'selected' : '' }}>
												{{ site.language }}
											</option>
										{% endfor %}
									</select>
								</form>
								</div>
								<a href="{{ siteUrl('entertainment') }}" class="c-button c-button_login d-flex justify-content-center align-items-center" data-i18n="login">Inloggen</a>
							</div>
						</div>
					</nav>
				</div>
			</div>
		</div>

		<main>
			{% block content %}
				<div class="container-fluid">
					<div class="c-banner"></div>
					<div class="container c-landing_container">
						<div class="row">
							<div class="c-landing d-flex justify-content-center">
								<div>
									<div class="d-flex justify-content-center">
										<h1 class="c-landing_header text-center" data-i18n="headline">Onbeperkt series, films en nog veel meer kijken</h1>
									</div>
									<h2 class="text-center" data-i18n="subheadline">Vanaf €9,99. Je kunt altijd opzeggen.</h2>
									<p class="text-center" data-i18n="description">Klaar om te kijken? voer je e-mailadres in om je lidmaatschap te starten of te hernieuwen</p>

									{% macro errorList(errors) %}
										{% if errors %}
											{{ ul(errors, {class: 'errors'}) }}
										{% endif %}
									{% endmacro %}

									{% set section = craft.app.entries.getSectionByHandle('form') %}
									{% set entryType = craft.app.entries.getEntryTypeByHandle('form') %}

									{% set entry = entry ?? create({
										class: 'craft\\elements\\Entry',
										sectionId: section.id,
										typeId: entryType.id,
									}) %}

									<form method="post" accept-charset="UTF-8" class="c-form d-flex justify-content-center">
										{{ csrfInput() }}
										{{ actionInput('entries/save-entry') }}
										{{ redirectInput('{url}') }}

										{{ hiddenInput('sectionId', entry.sectionId) }}
										{{ hiddenInput('typeId', entry.typeId) }}
										{{ hiddenInput('enabled', true) }}

										<label for="title" style="display: none;">Title</label>
										{{ input('text', 'title', entry.title or 'Default Value', {
											id: 'title',
											value: 'Default Value',
											style: 'display: none;',
										}) }}
										{{ _self.errorList(entry.getErrors('title')) }}


										{{ input('text', 'fields[email]', entry.getFieldValue('email'), {
											id: 'email',
											class: 'c-form_input',
										}) }}
										{{ _self.errorList(entry.getErrors('email')) }}


										<button type="submit" class="c-button c-button_email" data-i18n="button">
											Aan de slag
											<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" class="bi bi-chevron-right" viewbox="0 0 16 16">
												<path d="M4.646 1.646 L10.293 8 L4.646 14.354" stroke-linecap="round" stroke-linejoin="round"/>
											</svg>
										</button>
									</div>
								</div>
							</div>
						</div>
					</div>
					<div class="container">
						<div class="c-list">
							<h3 class="c-list_title" data-i18n="trending">Trending
							</h3>
							<div class="d-flex flex-nowrap overflow-auto c-list_scroll c-list_scroll-trending" style="scroll-snap-type: x mandatory;">
								{% set topRatedMovies = craft.entries()
								.section('entertainment')
								.orderBy('rating DESC') 
								.limit(10)      
								.all() 
							%}

								{% for post in topRatedMovies %}
									{% set image = post.featureImage.one() %}
									{% set rating = post.rating ?? 0 %}
									{% if image %}
										<a href="{{ post.url }}">
											<div class="c-trending_thumbnail d-flex">
												<p class="c-trending_ranking">{{ loop.index }}</p>
												<img src="{{ image.getUrl() }}" alt="{{ image.title }}" class="c-trending_img">
											</div>
										</a>
									{% endif %}
								{% endfor %}
							</div>
						</div>
					</div>
				{% endblock %}
			</main>
			<footer>
				<div class="container d-flex justify-content-center">
					<div class="row">
						<div class="c-footer">
							<div>
								<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="#fff" class="bi bi-facebook c-footer_icon" viewbox="0 0 16 16">
									<path d="M16 8.049c0-4.446-3.582-8.05-8-8.05C3.58 0-.002 3.603-.002 8.05c0 4.017 2.926 7.347 6.75 7.951v-5.625h-2.03V8.05H6.75V6.275c0-2.017 1.195-3.131 3.022-3.131.876 0 1.791.157 1.791.157v1.98h-1.009c-.993 0-1.303.621-1.303 1.258v1.51h2.218l-.354 2.326H9.25V16c3.824-.604 6.75-3.934 6.75-7.951"/>
								</svg>
								<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="#fff" class="bi bi-instagram c-footer_icon" viewbox="0 0 16 16">
									<path d="M8 0C5.829 0 5.556.01 4.703.048 3.85.088 3.269.222 2.76.42a3.9 3.9 0 0 0-1.417.923A3.9 3.9 0 0 0 .42 2.76C.222 3.268.087 3.85.048 4.7.01 5.555 0 5.827 0 8.001c0 2.172.01 2.444.048 3.297.04.852.174 1.433.372 1.942.205.526.478.972.923 1.417.444.445.89.719 1.416.923.51.198 1.09.333 1.942.372C5.555 15.99 5.827 16 8 16s2.444-.01 3.298-.048c.851-.04 1.434-.174 1.943-.372a3.9 3.9 0 0 0 1.416-.923c.445-.445.718-.891.923-1.417.197-.509.332-1.09.372-1.942C15.99 10.445 16 10.173 16 8s-.01-2.445-.048-3.299c-.04-.851-.175-1.433-.372-1.941a3.9 3.9 0 0 0-.923-1.417A3.9 3.9 0 0 0 13.24.42c-.51-.198-1.092-.333-1.943-.372C10.443.01 10.172 0 7.998 0zm-.717 1.442h.718c2.136 0 2.389.007 3.232.046.78.035 1.204.166 1.486.275.373.145.64.319.92.599s.453.546.598.92c.11.281.24.705.275 1.485.039.843.047 1.096.047 3.231s-.008 2.389-.047 3.232c-.035.78-.166 1.203-.275 1.485a2.5 2.5 0 0 1-.599.919c-.28.28-.546.453-.92.598-.28.11-.704.24-1.485.276-.843.038-1.096.047-3.232.047s-2.39-.009-3.233-.047c-.78-.036-1.203-.166-1.485-.276a2.5 2.5 0 0 1-.92-.598 2.5 2.5 0 0 1-.6-.92c-.109-.281-.24-.705-.275-1.485-.038-.843-.046-1.096-.046-3.233s.008-2.388.046-3.231c.036-.78.166-1.204.276-1.486.145-.373.319-.64.599-.92s.546-.453.92-.598c.282-.11.705-.24 1.485-.276.738-.034 1.024-.044 2.515-.045zm4.988 1.328a.96.96 0 1 0 0 1.92.96.96 0 0 0 0-1.92m-4.27 1.122a4.109 4.109 0 1 0 0 8.217 4.109 4.109 0 0 0 0-8.217m0 1.441a2.667 2.667 0 1 1 0 5.334 2.667 2.667 0 0 1 0-5.334"/>
								</svg>
								<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="#fff" class="bi bi-twitter-x c-footer_icon" viewbox="0 0 16 16">
									<path d="M12.6.75h2.454l-5.36 6.142L16 15.25h-4.937l-3.867-5.07-4.425 5.07H.316l5.733-6.57L0 .75h5.063l3.495 4.633L12.601.75Zm-.86 13.028h1.36L4.323 2.145H2.865z"/>
								</svg>
								<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="#fff" class="bi bi-youtube c-footer_icon" viewbox="0 0 16 16">
									<path d="M8.051 1.999h.089c.822.003 4.987.033 6.11.335a2.01 2.01 0 0 1 1.415 1.42c.101.38.172.883.22 1.402l.01.104.022.26.008.104c.065.914.073 1.77.074 1.957v.075c-.001.194-.01 1.108-.082 2.06l-.008.105-.009.104c-.05.572-.124 1.14-.235 1.558a2.01 2.01 0 0 1-1.415 1.42c-1.16.312-5.569.334-6.18.335h-.142c-.309 0-1.587-.006-2.927-.052l-.17-.006-.087-.004-.171-.007-.171-.007c-1.11-.049-2.167-.128-2.654-.26a2.01 2.01 0 0 1-1.415-1.419c-.111-.417-.185-.986-.235-1.558L.09 9.82l-.008-.104A31 31 0 0 1 0 7.68v-.123c.002-.215.01-.958.064-1.778l.007-.103.003-.052.008-.104.022-.26.01-.104c.048-.519.119-1.023.22-1.402a2.01 2.01 0 0 1 1.415-1.42c.487-.13 1.544-.21 2.654-.26l.17-.007.172-.006.086-.003.171-.007A100 100 0 0 1 7.858 2zM6.4 5.209v4.818l4.157-2.408z"/>
								</svg>
							</div>
							<div class="c-footer_links">
								<div class="c-footer_list">
									<a href="" class="c-footer_list-item" data-i18n="audioDescription">Audio Description</a>
									<a href="" class="c-footer_list-item" data-i18n="investorRelations">Investor Relations</a>
									<a href="" class="c-footer_list-item" data-i18n="legalNotices">Legal Notices</a>
									<a href="" class="c-footer_list-item" data-i18n="adChoices">Ad Choices</a>
								</div>
								<div class="c-footer_list">
									<a href="" class="c-footer_list-item" data-i18n="helpCenter">Help Center</a>
									<a href="" class="c-footer_list-item" data-i18n="jobs">Jobs</a>
									<a href="" class="c-footer_list-item" data-i18n="cookiePreferences">Cookie Preferences</a>
								</div>
								<div class="c-footer_list">
									<a href="" class="c-footer_list-item" data-i18n="giftCards">Gift Cards</a>
									<a href="" class="c-footer_list-item" data-i18n="termsOfUse">Terms Of Use</a>
									<a href="" class="c-footer_list-item" data-i18n="corporateInfo">Corporate Information</a>
								</div>
								<div class="c-footer_list">
									<a href="" class="c-footer_list-item" data-i18n="mediaCenter">Media Center</a>
									<a href="" class="c-footer_list-item" data-i18n="privacy">Privacy</a>
									<a href="" class="c-footer_list-item" data-i18n="contact">Contact</a>
								</div>
							</div>
							<div>
								<p class="c-footer_copy" data-i18n="copyright">©2025 Tibo Blommaert, Inc.</p>
							</div>

						</div>
					</div>
				</div>
			</footer>
		</body>
	</body>
</html>
